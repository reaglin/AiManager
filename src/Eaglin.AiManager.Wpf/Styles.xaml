<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Shared look for every AiManager surface. Plain system palette; nothing themed. -->

    <SolidColorBrush x:Key="Ai.Muted"  Color="#6B7280"/>
    <SolidColorBrush x:Key="Ai.Line"   Color="#D9DDE3"/>
    <SolidColorBrush x:Key="Ai.TileBg" Color="#F3F5F8"/>
    <SolidColorBrush x:Key="Ai.Ok"     Color="#16A34A"/>
    <SolidColorBrush x:Key="Ai.Bad"    Color="#DC2626"/>
    <SolidColorBrush x:Key="Ai.Off"    Color="#C4C9D1"/>
    <SolidColorBrush x:Key="Ai.Accent" Color="#2563EB"/>

    <Style x:Key="Ai.H1" TargetType="TextBlock">
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>

    <Style x:Key="Ai.H2" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,12,0,4"/>
    </Style>

    <Style x:Key="Ai.MutedText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Ai.Muted}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="Ai.Tile" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Ai.TileBg}"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Margin" Value="0,0,8,8"/>
        <Setter Property="MinWidth" Value="120"/>
    </Style>

    <Style x:Key="Ai.TileValue" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="Ai.TileLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Ai.Muted}"/>
        <Setter Property="FontSize" Value="11"/>
    </Style>

    <Style x:Key="Ai.Button" TargetType="Button">
        <Setter Property="Padding" Value="12,4"/>
        <Setter Property="MinWidth" Value="76"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
    </Style>

    <Style x:Key="Ai.SmallButton" TargetType="Button">
        <Setter Property="Padding" Value="8,2"/>
        <Setter Property="Margin" Value="4,0,0,0"/>
    </Style>

    <Style x:Key="Ai.Grid" TargetType="DataGrid">
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource Ai.Line}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Ai.Line}"/>
        <Setter Property="RowHeaderWidth" Value="0"/>
        <Setter Property="SelectionMode" Value="Single"/>
        <Setter Property="Background" Value="White"/>
    </Style>

</ResourceDictionary>
