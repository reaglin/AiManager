<UserControl x:Class="Eaglin.AiManager.Wpf.AiSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="760">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Eaglin.AiManager.Wpf;component/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Style="{StaticResource Ai.H1}" Text="AI Settings"/>
            <TextBlock x:Name="IntroText" Style="{StaticResource Ai.MutedText}"
                       Text="Keys are stored encrypted for this Windows user and shared by every app that uses the AI Manager."/>
            <TextBlock x:Name="HelpLinkText" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Ai.Line}" BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,12,0,0">
            <DockPanel>
                <TextBlock x:Name="FooterStatus" DockPanel.Dock="Left" VerticalAlignment="Center" Style="{StaticResource Ai.MutedText}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="ImportButton" Style="{StaticResource Ai.Button}" Content="Import keys…" Click="Import_Click"
                            ToolTip="Copy keys saved earlier by PreseMaker, CIATLE or AuthorPlus into the shared store."/>
                    <Button x:Name="RevertButton" Style="{StaticResource Ai.Button}" Content="Revert" Click="Revert_Click"/>
                    <Button x:Name="SaveButton" Style="{StaticResource Ai.Button}" Content="Save" Click="Save_Click" IsDefault="True" FontWeight="SemiBold"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Style="{StaticResource Ai.H2}" Text="Providers"/>
                <Grid x:Name="ProviderGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>   <!-- dot -->
                        <ColumnDefinition Width="130"/>    <!-- name -->
                        <ColumnDefinition Width="*"/>      <!-- key -->
                        <ColumnDefinition Width="Auto"/>   <!-- show -->
                        <ColumnDefinition Width="220"/>    <!-- model (all programs) -->
                        <ColumnDefinition x:Name="AppModelColumn" Width="200"/>    <!-- model for this app; 0 in the standalone program -->
                        <ColumnDefinition Width="Auto"/>   <!-- refresh -->
                        <ColumnDefinition Width="Auto"/>   <!-- test -->
                        <ColumnDefinition Width="170"/>    <!-- status -->
                    </Grid.ColumnDefinitions>
                </Grid>
                <TextBlock x:Name="AppModelHint" Margin="0,6,0,0" TextWrapping="Wrap" Style="{StaticResource Ai.MutedText}"/>

                <TextBlock Style="{StaticResource Ai.H2}" Text="Defaults"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="240"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="Default provider for all programs"/>
                    <ComboBox  Grid.Row="0" Grid.Column="1" x:Name="DefaultProviderBox" Margin="0,2"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" x:Name="AppDefaultLabel" VerticalAlignment="Center" Text="Provider for this program"/>
                    <ComboBox  Grid.Row="1" Grid.Column="1" x:Name="AppDefaultProviderBox" Margin="0,2"/>
                    <TextBlock Grid.Row="1" Grid.Column="2" x:Name="AppDefaultHint" Margin="10,0,0,0" VerticalAlignment="Center" Style="{StaticResource Ai.MutedText}"/>

                    <!-- Pictures (1.7.0): only the providers that can draw are offered. -->
                    <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="Provider for pictures (all programs)"/>
                    <ComboBox  Grid.Row="2" Grid.Column="1" x:Name="ImageProviderBox" Margin="0,2" SelectionChanged="ImageProvider_Changed"
                               ToolTip="Only OpenAI, Gemini (Google) and xAI can make pictures — Claude and Mistral AI cannot. Automatic uses the provider a program already uses when it can draw, else the first of these that has a key. Each picture costs a few cents on that key."/>
                    <TextBlock Grid.Row="2" Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" Style="{StaticResource Ai.MutedText}" TextWrapping="Wrap"
                               Text="Only OpenAI, Gemini and xAI can make pictures; Claude and Mistral AI cannot. Each picture costs a few cents on that key."/>

                    <TextBlock Grid.Row="3" Grid.Column="0" x:Name="AppImageLabel" VerticalAlignment="Center" Text="Pictures for this program"/>
                    <ComboBox  Grid.Row="3" Grid.Column="1" x:Name="AppImageProviderBox" Margin="0,2" SelectionChanged="ImageProvider_Changed"/>

                    <TextBlock Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" x:Name="ImageNowText" Margin="0,0,0,6" Style="{StaticResource Ai.MutedText}" TextWrapping="Wrap"/>

                    <TextBlock Grid.Row="5" Grid.Column="0" VerticalAlignment="Center" Text="Monthly budget warning (USD)"/>
                    <TextBox   Grid.Row="5" Grid.Column="1" x:Name="BudgetBox" Margin="0,2" Width="100" HorizontalAlignment="Left"/>
                    <TextBlock Grid.Row="5" Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" Style="{StaticResource Ai.MutedText}"
                               Text="Blank = no warning. Costs are estimates from list prices."/>
                </Grid>

                <!-- Voices (1.8.0): Google Cloud Text-to-Speech, its own credential. Saved at once, not by the Save button below. -->
                <TextBlock Style="{StaticResource Ai.H2}" Text="Voices — Google text-to-speech"/>
                <TextBlock x:Name="VoiceIntro" Style="{StaticResource Ai.MutedText}" Margin="0,0,0,6"
                           Text="Programs that read aloud (for example Author+'s audiobooks) use Google's voices. This needs a Google Cloud key — a Gemini key does not work here. The key is kept encrypted on this computer and is saved as soon as you click Save key (the Save button at the bottom is not needed for it)."/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="Google Cloud API key"/>
                    <PasswordBox Grid.Row="0" Grid.Column="1" x:Name="VoiceKeyBox" Margin="0,3" VerticalContentAlignment="Center"
                                 AutomationProperties.Name="Google text-to-speech API key"
                                 ToolTip="Paste a key made in the Google Cloud console under APIs &amp; Services ▸ Credentials (not a Gemini key from AI Studio). It is hidden as you type. How? says where to get one."/>
                    <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" Margin="6,0,0,0">
                        <Button x:Name="VoiceSaveButton" Style="{StaticResource Ai.SmallButton}" Content="Save key" Click="VoiceSave_Click"
                                ToolTip="Saves the key in the box (encrypted) for every program that uses AI Manager. It takes effect at once."/>
                        <Button x:Name="VoiceClearButton" Style="{StaticResource Ai.SmallButton}" Content="Clear" Click="VoiceClear_Click"
                                ToolTipService.ShowOnDisabled="True"
                                ToolTip="Removes the stored Google text-to-speech key or service account from this computer (it asks first)."/>
                        <TextBlock VerticalAlignment="Center" Margin="10,0,0,0">
                            <Hyperlink x:Name="VoiceHowLink" Click="VoiceHow_Click"
                                       AutomationProperties.Name="How to get a Google text-to-speech key: steps and what to choose"
                                       ToolTip="The steps for getting a Google Cloud key for voices: make a project, turn on billing and the Cloud Text-to-Speech API, create and restrict a key. Also what it costs.">How?</Hyperlink>
                        </TextBlock>
                    </StackPanel>

                    <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="Or a service account" Style="{StaticResource Ai.MutedText}"/>
                    <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,3">
                        <Button x:Name="VoiceFileButton" Style="{StaticResource Ai.SmallButton}" Margin="0" Content="Use a service-account file…" Click="VoiceFile_Click"
                                ToolTip="For people who already have a Google Cloud service-account key file (.json), as CourseBuilder+ used. The file's content is stored encrypted, so the file may be moved or deleted afterwards. Most people should use an API key instead."/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="VoiceDot" Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Status" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="VoiceStatus" Margin="0,4" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Horizontal" Margin="6,0,0,0" VerticalAlignment="Center">
                        <Button x:Name="VoiceTestButton" Style="{StaticResource Ai.SmallButton}" Content="Test" Click="VoiceTest_Click"
                                ToolTipService.ShowOnDisabled="True"
                                ToolTip="Asks Google for its list of voices with the stored key. Nothing is spoken and nothing is charged."/>
                        <Button x:Name="VoiceTryButton" Style="{StaticResource Ai.SmallButton}" Content="Try the voices…" Click="VoiceTry_Click"
                                ToolTipService.ShowOnDisabled="True"
                                ToolTip="Opens the list of Google's voices, where you can hear a sample sentence in any of them. Each sample costs a fraction of a cent (or nothing within Google's free monthly characters)."/>
                    </StackPanel>
                </Grid>

                <TextBlock x:Name="PathText" Margin="0,16,0,0" Style="{StaticResource Ai.MutedText}"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
