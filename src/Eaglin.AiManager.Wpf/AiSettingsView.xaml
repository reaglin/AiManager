<UserControl x:Class="Eaglin.AiManager.Wpf.AiSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="760">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Eaglin.AiManager.Wpf;component/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Style="{StaticResource Ai.H1}" Text="AI Settings"/>
            <TextBlock x:Name="IntroText" Style="{StaticResource Ai.MutedText}"
                       Text="Keys are stored encrypted for this Windows user and shared by every app that uses the AI Manager."/>
            <TextBlock x:Name="HelpLinkText" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Ai.Line}" BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,12,0,0">
            <DockPanel>
                <TextBlock x:Name="FooterStatus" DockPanel.Dock="Left" VerticalAlignment="Center" Style="{StaticResource Ai.MutedText}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="ImportButton" Style="{StaticResource Ai.Button}" Content="Import keys…" Click="Import_Click"
                            ToolTip="Copy keys saved earlier by PreseMaker, CIATLE or AuthorPlus into the shared store."/>
                    <Button x:Name="RevertButton" Style="{StaticResource Ai.Button}" Content="Revert" Click="Revert_Click"/>
                    <Button x:Name="SaveButton" Style="{StaticResource Ai.Button}" Content="Save" Click="Save_Click" IsDefault="True" FontWeight="SemiBold"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Style="{StaticResource Ai.H2}" Text="Providers"/>
                <Grid x:Name="ProviderGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>   <!-- dot -->
                        <ColumnDefinition Width="130"/>    <!-- name -->
                        <ColumnDefinition Width="*"/>      <!-- key -->
                        <ColumnDefinition Width="Auto"/>   <!-- show -->
                        <ColumnDefinition Width="220"/>    <!-- model (all programs) -->
                        <ColumnDefinition x:Name="AppModelColumn" Width="200"/>    <!-- model for this app; 0 in the standalone program -->
                        <ColumnDefinition Width="Auto"/>   <!-- refresh -->
                        <ColumnDefinition Width="Auto"/>   <!-- test -->
                        <ColumnDefinition Width="170"/>    <!-- status -->
                    </Grid.ColumnDefinitions>
                </Grid>
                <TextBlock x:Name="AppModelHint" Margin="0,6,0,0" TextWrapping="Wrap" Style="{StaticResource Ai.MutedText}"/>

                <TextBlock Style="{StaticResource Ai.H2}" Text="Defaults"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="240"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="Default provider for all programs"/>
                    <ComboBox  Grid.Row="0" Grid.Column="1" x:Name="DefaultProviderBox" Margin="0,2"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" x:Name="AppDefaultLabel" VerticalAlignment="Center" Text="Provider for this program"/>
                    <ComboBox  Grid.Row="1" Grid.Column="1" x:Name="AppDefaultProviderBox" Margin="0,2"/>
                    <TextBlock Grid.Row="1" Grid.Column="2" x:Name="AppDefaultHint" Margin="10,0,0,0" VerticalAlignment="Center" Style="{StaticResource Ai.MutedText}"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="Monthly budget warning (USD)"/>
                    <TextBox   Grid.Row="2" Grid.Column="1" x:Name="BudgetBox" Margin="0,2" Width="100" HorizontalAlignment="Left"/>
                    <TextBlock Grid.Row="2" Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" Style="{StaticResource Ai.MutedText}"
                               Text="Blank = no warning. Costs are estimates from list prices."/>
                </Grid>

                <TextBlock x:Name="PathText" Margin="0,16,0,0" Style="{StaticResource Ai.MutedText}"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
