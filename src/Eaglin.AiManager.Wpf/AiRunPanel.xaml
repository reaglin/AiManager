<UserControl x:Class="Eaglin.AiManager.Wpf.AiRunPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="120">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Eaglin.AiManager.Wpf;component/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <DockPanel>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
            <Button x:Name="StopButton" DockPanel.Dock="Right" Content="Stop" Style="{StaticResource Ai.SmallButton}" IsEnabled="False" Click="Stop_Click"/>
            <Button x:Name="CopyButton" DockPanel.Dock="Right" Content="Copy" Style="{StaticResource Ai.SmallButton}" IsEnabled="False" Click="Copy_Click"/>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Style="{StaticResource Ai.MutedText}" Text="Ready."/>
        </DockPanel>
        <TextBox x:Name="Output" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 FontSize="13" Padding="8" Background="White" BorderBrush="{StaticResource Ai.Line}"/>
    </DockPanel>
</UserControl>
