<UserControl x:Class="Eaglin.AiManager.Wpf.PromptLibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="760" MinHeight="420">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Eaglin.AiManager.Wpf;component/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <DockPanel Margin="16">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                <TextBlock Text="App:" VerticalAlignment="Center" Margin="0,0,6,0" x:Name="AppLabel"/>
                <ComboBox x:Name="AppBox" Width="160" SelectionChanged="AppBox_SelectionChanged"/>
            </StackPanel>
            <StackPanel>
                <TextBlock Style="{StaticResource Ai.H1}" Text="Prompt Library"/>
                <TextBlock Style="{StaticResource Ai.MutedText}"
                           Text="The prompts an app sends. Edit the wording; {placeholders} are filled in by the app at run time."/>
            </StackPanel>
        </DockPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button x:Name="NewButton" Content="New" Style="{StaticResource Ai.SmallButton}" Margin="0" Click="New_Click"/>
                    <Button x:Name="DeleteButton" Content="Delete" Style="{StaticResource Ai.SmallButton}" Click="Delete_Click"/>
                </StackPanel>
                <ListBox x:Name="TemplateList" SelectionChanged="TemplateList_SelectionChanged" DisplayMemberPath="Label"/>
            </DockPanel>

            <DockPanel Grid.Column="2" x:Name="EditorPanel">
                <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Ai.Line}" BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,10,0,0">
                    <DockPanel>
                        <TextBlock x:Name="FooterStatus" VerticalAlignment="Center" Style="{StaticResource Ai.MutedText}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="ResetButton" Content="Reset to default" Style="{StaticResource Ai.Button}" Click="Reset_Click"/>
                            <Button x:Name="SaveButton" Content="Save" Style="{StaticResource Ai.Button}" FontWeight="SemiBold" Click="Save_Click"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="2*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Name" Margin="0,4,10,4" VerticalAlignment="Center"/>
                    <DockPanel Grid.Row="0" Grid.Column="1" Margin="0,2">
                        <TextBlock x:Name="KindText" DockPanel.Dock="Right" Margin="10,0,0,0" VerticalAlignment="Center" Style="{StaticResource Ai.MutedText}"/>
                        <TextBox x:Name="NameBox"/>
                    </DockPanel>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Description" Margin="0,4,10,4" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="DescriptionBox" Margin="0,2"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="System" Margin="0,4,10,4" VerticalAlignment="Top"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource Ai.MutedText}" Text="Who the AI is and how it should answer."/>
                    <TextBox Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" x:Name="SystemBox" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" MinHeight="70" Margin="0,2,0,6" TextChanged="Text_TextChanged" FontFamily="Consolas"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="User" Margin="0,4,10,4" VerticalAlignment="Top"/>
                    <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource Ai.MutedText}" Text="The request itself, with {placeholders} for what the app supplies."/>
                    <TextBox Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" x:Name="UserBox" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" MinHeight="110" Margin="0,2,0,6" TextChanged="Text_TextChanged" FontFamily="Consolas"/>

                    <StackPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,2">
                        <TextBlock Text="Max output tokens" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="MaxTokensBox" Width="80"/>
                        <TextBlock Text="Placeholders:" VerticalAlignment="Center" Margin="24,0,6,0"/>
                        <TextBlock x:Name="PlaceholdersText" VerticalAlignment="Center" FontFamily="Consolas"/>
                    </StackPanel>

                    <Expander Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2" Header="Preview with sample values" Margin="0,6,0,0" x:Name="PreviewExpander">
                        <StackPanel Margin="0,6,0,0">
                            <Grid x:Name="SampleGrid">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                            </Grid>
                            <Button Content="Preview" Style="{StaticResource Ai.SmallButton}" HorizontalAlignment="Left" Margin="0,6,0,6" Click="Preview_Click"/>
                            <TextBox x:Name="PreviewBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90" MaxHeight="220"
                                     VerticalScrollBarVisibility="Auto" FontFamily="Consolas" Background="{StaticResource Ai.TileBg}"/>
                        </StackPanel>
                    </Expander>
                </Grid>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
